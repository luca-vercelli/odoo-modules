<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.exportts</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="Sistema TS"
                    string="Sistema TS"
                    name="l10n_it_export_ts"
                    groups="base.group_system"
                >
                    <block title="Sistema TS" name="sistema_ts">
                        <setting
                            string="Parametri di invio"
                            help="Imposta i parametri per l'invio delle fatture verso Sistema TS"
                        >
                            <div class="content-group">
                                <div class="row mt16">
                                    <label
                                        for="default_proprietario_id"
                                        class="col-lg-3 o_light_label"
                                    />
                                    <field name="default_proprietario_id" />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="default_pincode_inviante"
                                        class="col-lg-3 o_light_label"
                                    />
                                    <field name="default_pincode_inviante" />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="default_password_inviante"
                                        class="col-lg-3 o_light_label"
                                    />
                                    <field name="default_password_inviante" />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="default_endpoint"
                                        class="col-lg-3 o_light_label"
                                    />
                                    <field name="default_endpoint" />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="default_folder"
                                        class="col-lg-3 o_light_label"
                                    />
                                    <field name="default_folder" />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_exportts_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'l10n_it_export_ts'}</field>
    </record>

    <menuitem
        id="menu_exportts_config"
        name="Settings"
        parent="menu_sistema_ts"
        sequence="40"
        action="action_exportts_config"
        groups="base.group_system"
    />
</odoo>
